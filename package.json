{
  "name": "app-market-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Independent, local-first mobile market intelligence for the App Store and Google Play.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "migrate": "tsx server/cli/migrate.ts",
    "dev": "concurrently -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "dev:demo": "cross-env APP_MODE=demo npm run dev",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "start:demo": "cross-env APP_MODE=demo tsx server/index.ts",
    "demo": "npm run seed:demo && npm run build && npm run start:demo",
    "seed:demo": "cross-env APP_MODE=demo tsx server/cli/seed-demo.ts",
    "ingest": "tsx server/cli/ingest.ts",
    "ingest:dry": "tsx server/cli/ingest.ts --dry-run",
    "smoke:live": "tsx server/cli/smoke-live.ts",
    "smoke:api": "tsx server/cli/smoke-api.ts",
    "backup": "tsx server/cli/backup.ts",
    "export:public": "cross-env VITE_PUBLIC_MODE=true vite build --outDir ../dist-public --emptyOutDir && tsx server/cli/export-public.ts",
    "verify:public": "tsx server/cli/verify-public.ts",
    "preview:public": "vite preview --outDir ../dist-public --port 4174 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "export:public:demo": "cross-env APP_MODE=demo npm run export:public",
    "cloud:pack": "tsx server/cli/cloud.ts pack",
    "cloud:restore": "tsx server/cli/cloud.ts restore",
    "cloud:pull": "tsx server/cli/cloud.ts pull",
    "start:cloud": "cross-env DB_PATH=data/cloud.db tsx server/index.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
