# App Market Radar — copy to .env and adjust. Every value has a safe default.
# live | demo. Demo uses a separate database file seeded with FICTIONAL records.
APP_MODE=live
# Loopback only by default. Do not bind to 0.0.0.0 unless you understand the write routes are unauthenticated.
HOST=127.0.0.1
PORT=5174
# SQLite files (relative to repo root). Live and demo are always separate files.
DB_PATH=data/radar.db
DEMO_DB_PATH=data/demo.db
BACKUP_DIR=backups

# Markets to ingest (must exist and be enabled in the market registry). Comma separated ISO 3166 alpha-2, lowercase.
INGEST_MARKETS=us,in
# Requested chart depth for Apple feeds (1-200).
CHART_DEPTH=100
# Which Apple charts to collect. Format: device:type:genre  (device iphone|ipad, type free|paid|grossing, genre "all" or an Apple genre id)
APPLE_CHARTS=iphone:free:all,iphone:paid:all,iphone:grossing:all,iphone:free:6014,iphone:paid:6014,iphone:grossing:6014
# Max requests per provider per run (budget). The run stops that provider when exhausted.
BUDGET_APPLE_RSS=60
BUDGET_ITUNES_LOOKUP=40
BUDGET_GOOGLE_PLAY=30
# Google Play public detail-page reader for packages you have registered. Set to false to disable entirely.
GOOGLE_PLAY_READER_ENABLED=true
# Minimum milliseconds between requests per provider (politeness).
APPLE_MIN_INTERVAL_MS=1500
GOOGLE_PLAY_MIN_INTERVAL_MS=4000
HTTP_TIMEOUT_MS=15000
# HTTP cache TTL for identical GETs, minutes.
HTTP_CACHE_TTL_MIN=360
# Alert threshold: rank positions moved day-over-day.
ALERT_RANK_THRESHOLD=10
# Max upload size for imports (bytes).
IMPORT_MAX_BYTES=5000000
# Retention: delete raw HTTP cache older than N days (observations are never auto-deleted).
CACHE_RETENTION_DAYS=7
